{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/rejoindre",  "destination": "/rejoindre/index.html" },
    { "source": "/editor",   "destination": "/editor/index.html" },
    { "source": "/editor/((?!assets/).*)", "destination": "/editor/index.html" },
    { "source": "/trainer",  "destination": "/trainer/index.html" },
    { "source": "/trainer/((?!assets/).*)", "destination": "/trainer/index.html" },
    { "source": "/equity",  "destination": "/equity/index.html" },
    { "source": "/equity/((?!assets/).*)", "destination": "/equity/index.html" },
    { "source": "/tournoi",  "destination": "/tournoi/index.html" },
    { "source": "/tournoi/((?!assets/).*)", "destination": "/tournoi/index.html" },
    { "source": "/initiation",  "destination": "/initiation/index.html" },
    { "source": "/initiation/((?!assets/).*)", "destination": "/initiation/index.html" },
    { "source": "/club",  "destination": "/club/index.html" },
    { "source": "/club/((?!assets/).*)", "destination": "/club/index.html" },
    { "source": "/carnet",  "destination": "/carnet/index.html" },
    { "source": "/carnet/((?!assets/).*)", "destination": "/carnet/index.html" }
  ]
}
